# Copy to .env and fill in. .env itself is gitignored — never commit real keys.

APP_NAME=Smart Traffic Sign Recognition API
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# MySQL through WampServer. If the connection fails the app falls back to SQLite
# (smart_traffic.db), which is fine for a demo.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_traffic

# Google AI Studio key — used for sign classification, document OCR and the assistant.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Nominatim asks for a contact address in the User-Agent
OSM_USER_AGENT=RoadSafetyAI/1.0 (your-email@example.com)

# Model weights — not in git, see README.md
YOLO_WEIGHTS=app/ml/weights/yolov8_traffic.pt
RESNET_WEIGHTS=app/ml/weights/resnet50_gtsrb.pth

FRONTEND_ORIGIN=http://localhost:5173
